# Public site configuration (no secrets).
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Arena Kyvora
NEXT_PUBLIC_GESTAO_URL=http://localhost:5173
NEXT_PUBLIC_KYVORA_API_BASE_URL=http://localhost:8000

# Optional lead capture URL (Formspree, Typeform, etc.)
# Leave empty to fall back to contact email
NEXT_PUBLIC_WAITLIST_URL=
NEXT_PUBLIC_CONTACT_EMAIL=contato@kyvoraapp.com.br

# Marketing / Analytics (public client identifiers only — never secrets)
# Scripts load only when ENABLE_ANALYTICS=true AND the user grants consent.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Indexing: false for local/HML. true only on authorized production go-live.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Playwright E2E (never commit real passwords)
# ---------------------------------------------------------------------------
# Local: omit PLAYWRIGHT_BASE_URL to start `npm run build && npm run start`.
# HML: set PLAYWRIGHT_BASE_URL=https://hml-arena.kyvoraapp.com.br
# PLAYWRIGHT_API_BASE_URL=https://hml-api.kyvoraapp.com.br
# Required only for authenticated E2E suites (no fallback in code):
ARENA_E2E_PASSWORD=
# Optional pre-existing demo accounts (skip register):
# ARENA_E2E_USER_A_EMAIL=
# ARENA_E2E_USER_B_EMAIL=

# Arena Admin (isolated Vite app in ./admin — never shares GA4 with public Arena)
# Local: cd admin && npm run dev  → http://localhost:3020
# See admin/.env.example for VITE_API_BASE_URL / VITE_APP_ENV
