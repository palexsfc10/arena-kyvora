# Public site configuration (no secrets)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Arena Kyvora
NEXT_PUBLIC_GESTAO_URL=http://localhost:5173
NEXT_PUBLIC_KYVORA_API_BASE_URL=http://localhost:8000

# Optional lead capture URL (Formspree, Typeform, etc.)
# Leave empty to fall back to contact email
NEXT_PUBLIC_WAITLIST_URL=
NEXT_PUBLIC_CONTACT_EMAIL=contato@kyvoraapp.com.br

# Marketing / Analytics (Next.js public env — not Vite)
# GA Measurement IDs are public client identifiers, not secrets.
# Scripts load only when ENABLE_ANALYTICS=true AND the user grants consent.
# Note: this is a Next.js app, so the public var is NEXT_PUBLIC_GA_MEASUREMENT_ID
# (equivalent intent to VITE_GA_MEASUREMENT_ID in Vite projects).
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WQTRFL6M1J
NEXT_PUBLIC_META_PIXEL_ID=

# Arena Admin (isolated Vite app in ./admin — never shares GA4 with public Arena)
# Local: cd admin && npm run dev  → http://localhost:3020
# HML domain: https://hml-adm-arena.kyvoraapp.com.br
# Prod domain: https://adm-arena.kyvoraapp.com.br
# See admin/.env.example for VITE_API_BASE_URL / VITE_APP_ENV
