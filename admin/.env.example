# Arena Admin — configuração de ambiente (Vite)
# Copie para .env.local (nunca versione .env reais).
# VITE_* são embutidos no bundle no build — nunca coloque senha, token ou segredo.

# URL base da API Kyvora (backend compartilhado). Em dev local o proxy Vite
# também redireciona /api para este endereço.
VITE_API_BASE_URL=http://localhost:8000

# Ambiente: development | staging | production
# staging/HML deve apontar exclusivamente para hml-api.kyvoraapp.com.br
# production (go-live futuro) usará api.kyvoraapp.com.br — não configurar agora.
VITE_APP_ENV=development
