# Arena Admin — configuração de ambiente (Vite)
# Copie este arquivo para .env (ou .env.local) e ajuste os valores.

# URL base da API Kyvora (backend). Em desenvolvimento local, o proxy do
# Vite também redireciona /api para este endereço.
VITE_API_BASE_URL=http://localhost:8000

# Ambiente da aplicação: development | staging | production
# Controla, por exemplo, a exibição do selo "HML" no painel.
VITE_APP_ENV=development
