# Arena Kyvora HML — public build-time variables only (no secrets).
# Used as docker build args / local reference. NEVER put JWT, DB, or SMTP here.

# Public site (Cloudflare Tunnel hostname)
NEXT_PUBLIC_SITE_URL=https://hml-arena.kyvoraapp.com.br
NEXT_PUBLIC_SITE_NAME=Arena Kyvora

# Public API (same Kyvora HML API stack — never jarvis IP / internal hostname)
NEXT_PUBLIC_KYVORA_API_BASE_URL=https://hml-api.kyvoraapp.com.br

# Optional ecosystem link (Gestão HML if available; marketing only)
NEXT_PUBLIC_GESTAO_URL=https://hml.kyvoraapp.com.br

NEXT_PUBLIC_WAITLIST_URL=
NEXT_PUBLIC_CONTACT_EMAIL=contato@kyvoraapp.com.br
# Enable after consent banner; Measurement ID is public (not a secret).
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WQTRFL6M1J
NEXT_PUBLIC_META_PIXEL_ID=

# Local bind alternative (Jarvis loopback only — not for public clients):
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3010
# NEXT_PUBLIC_KYVORA_API_BASE_URL=http://127.0.0.1:8010
# NEXT_PUBLIC_GESTAO_URL=http://127.0.0.1:5180
